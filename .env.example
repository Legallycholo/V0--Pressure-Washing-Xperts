# Public site URL (no trailing slash) — used for canonical URLs, sitemap, robots, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.pressurewashingxpert.com

# Google Cloud config (server-side) for the Vertex AI (ADK) chat runtime.
GOOGLE_CLOUD_PROJECT=pressurewashing-xperts
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_AGENT_RESOURCE_ID=replace_with_reasoning_engine_id
GOOGLE_ADK_APP_NAME=pressure_washing_xperts_lead_agent
# Paste the full JSON from your GCP service account key as one line.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Supabase (lead database) — required for /api/contact to save callback requests.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
# Server-only, bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Resend — lead/contact email notifications (/api/contact, /api/active-lead).
# RESEND_API_KEY=re_your_key_here

# Vonage — SMS notifications via /api/contact.
# VONAGE_API_KEY=your_vonage_api_key
# VONAGE_API_SECRET=your_vonage_api_secret
# VONAGE_FROM_NUMBER=PWXperts
# VONAGE_TO_NUMBER=+1xxxxxxxxxx
