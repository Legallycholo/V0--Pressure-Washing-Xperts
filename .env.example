# Public site URL (no trailing slash) — used for canonical URLs, sitemap, robots, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.pressurewashingxpert.com

# Google Cloud config (server-side) for BigQuery leads + ADK chat runtime.
GOOGLE_CLOUD_PROJECT=pressurewashing-xperts
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_LEADS_DATASET=leads_crm
GOOGLE_LEADS_TABLE=inbound_leads
GOOGLE_AGENT_RESOURCE_ID=replace_with_reasoning_engine_id
GOOGLE_ADK_APP_NAME=pressure_washing_xperts_lead_agent
# Paste the full JSON from your GCP service account key as one line.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Required for `/api/active-lead` (high-intent visitor emails via Resend).
# RESEND_API_KEY=re_your_key_here

# Twilio — SMS notifications via /api/contact
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# TWILIO_TO_NUMBER=+1xxxxxxxxxx
# TWILIO_NOTIFY_PHONE is also supported as a fallback for TWILIO_TO_NUMBER
